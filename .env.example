# === Phase 0 (변환 CLI) ===
# Anthropic Claude API — 구조화·채점
ANTHROPIC_API_KEY=

# 구조화 모델 override (기본: claude-sonnet-4-6)
# HANDOVER_MODEL=claude-sonnet-4-6

# OpenAI Whisper STT — 키 있으면 영상/오디오 업로드가 실제 변환됨
OPENAI_API_KEY=

# STT 강제 전환 (미설정: 키 있으면 whisper, 없으면 mock)
# HANDOVER_STT=whisper | mock

# 구조화 프롬프트 버전 비교: npm run compare -- structure-v1 structure-v2

# === Phase 1 (웹 앱) ===
# ⚠️ 이 프로젝트 전용 새 Supabase 프로젝트를 만들 것 (다른 프로젝트 키 재사용 금지)
# 1) supabase.com 에서 새 프로젝트 생성
# 2) supabase/migrations/0001_init.sql 을 SQL Editor에서 실행
# 3) 아래 키 입력 (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Phase 2 (결제·보안·운영) ===
# Vercel cron → /api/cron/* 보호용 임의 비밀 문자열 (예: openssl rand -hex 32)
CRON_SECRET=

# Groq Whisper STT — HANDOVER_STT=groq 또는 GROQ_API_KEY 있으면 자동 선택
GROQ_API_KEY=

# 토스페이먼츠 건당 결제 (test_ 키는 토스 개발자센터에서 발급)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# === Phase 3 (골든셋 경로) ===
# 채점 스크립트 골든셋 폴더 (기본 ./golden). 비공개 실데이터: ./private-data/golden (golden/README.md)
# GOLDEN_DIR=./golden

# AI 호출 사용자별 레이트리밋 (시간당 횟수, 0007_rate_limits.sql 필요)
# RATE_LIMIT_PIPELINE_PER_HOUR=20   # 업로드 완료·재시도 (STT+구조화)
# RATE_LIMIT_AI_EDIT_PER_HOUR=60    # 보강 질문 답변 다듬기

# === Phase 3-A② (작업 큐·관측) ===
# 파이프라인 실행 방식: inngest(기본, 운영) | inline(요청 후 after 훅 — 로컬·mock용)
# HANDOVER_QUEUE=inngest
# Inngest — 운영은 Vercel Inngest Integration이 자동 주입. 로컬은 INNGEST_DEV=1 + npx inngest-cli@latest dev -u http://localhost:3010/api/inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1
# Sentry (비우면 비활성) — 서버·브라우저 DSN
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# e2e를 배포 URL 대상으로: E2E_BASE_URL=https://<배포 도메인> npm run e2e
# E2E_BASE_URL=

# 에이전트(agent/) 임베딩 — EMBEDDING_PROVIDER=voyage(기본) | local(bge-m3, sentence-transformers CPU)
# VOYAGE_API_KEY는 provider=voyage일 때만 필수. EMBEDDING_MODEL 비우면 provider별 기본(voyage-4 / BAAI/bge-m3)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=
# 실행당 임베딩 토큰 상한(넘으면 그 실행 중단·사용량 보고). 기본 200000
EMBEDDING_TOKEN_BUDGET=200000
# 에이전트(agent/) LLM — 모델은 기존 앱과 같은 HANDOVER_MODEL(비우면 claude-sonnet-4-6), 채점은 Groq(GROQ_API_KEY 필요)
# AGENT_COST_BUDGET_USD: 실행당 Claude 비용 상한(넘으면 중단), AGENT_JUDGE_MODEL: 채점 모델(Claude 계열 금지)
AGENT_COST_BUDGET_USD=5
AGENT_JUDGE_MODEL=openai/gpt-oss-120b
# 에이전트 질문 화면(/agent-demo) — 로컬 데모 전용. true일 때만 화면·프록시(/api/agent-demo/*)가 열린다(프로덕션 기본 꺼짐)
# 에이전트 API는 npm run agent:serve 로 127.0.0.1:AGENT_PORT(기본 8000)에만 뜬다(인증 없음, 외부 노출 금지)
NEXT_PUBLIC_AGENT_ENABLED=
AGENT_PORT=
