{
  "name": "handover_helper",
  "version": "0.1.0",
  "description": "인수인계 영상 → 문서 변환 SaaS (Phase 0: 골든셋 품질 검증)",
  "private": true,
  "type": "module",
  "scripts": {
    "convert": "tsx scripts/convert.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "compare": "tsx scripts/compare-prompts.ts",
    "report": "tsx scripts/report-misses.ts",
    "checklist": "tsx scripts/build-checklist.ts",
    "e2e": "node --conditions=react-server --import tsx scripts/e2e-pipeline.ts",
    "typecheck": "tsc --noEmit",
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint .",
    "test:rls": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/rls.integration.test.ts",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/rls.integration.test.ts tests/pipeline-start.integration.test.ts",
    "agent:test": "uv run --project agent pytest agent/tests",
    "agent:lint": "uv run --directory agent ruff check . ../eval",
    "agent:retrieval": "uv run --project agent python eval/retrieval.py"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.103.0",
    "@sentry/nextjs": "^11.1.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tosspayments/payment-sdk": "^1.9.3",
    "@vercel/analytics": "^2.0.1",
    "docx": "^9.7.1",
    "ffmpeg-static": "^5.3.0",
    "inngest": "^4.21.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanitize-html": "^2.17.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  }
}
